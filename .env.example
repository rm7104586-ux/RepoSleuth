# RepoSleuth Environment Variables Configuration
# Copy this file to .env for local overrides, or set these in Render Dashboard > Environment.

# Django Security Key (Generate a random string for production)
SECRET_KEY=your-super-secret-key-change-in-production

# Debug Mode: False for production, True for local development
DEBUG=False

# Allowed Hosts (comma-separated). On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL Database URL (Render provides this in your PostgreSQL Database settings)
# Example: postgres://user:password@hostname:5432/dbname
# Leave blank to automatically use local SQLite (db.sqlite3)
DATABASE_URL=

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# SSL Redirect (optional, defaults to True when DEBUG=False)
SECURE_SSL_REDIRECT=True
